cabal-version:      3.0
name:               parsing
version:            0.1.0.0
synopsis:           Haskell January Test 2025 - Recursive-Descent Parsing
description:        Practice version of an Imperial College Haskell January Test (Tony Field), packaged as a cabal project.
author:             Imperial College London
maintainer:         skeleton
build-type:         Simple
extra-doc-files:    README.md

common common-settings
    -- Options to pass to GHC, in this case, we want to turn on warnings
    ghc-options: -Wtabs -Wunused-binds -Wincomplete-patterns -Wmissing-signatures
    -- Base language which the package is written in.
    default-language: GHC2021
    -- The range of GHC base library verisons that are supported
    build-depends:    base >=4.13 && <5, containers

library
    import:           common-settings
    -- Modules exported by the library.
    exposed-modules:  Parser, Types, Lexer, Examples
    -- Directories containing source files.
    hs-source-dirs:   src

test-suite parsing-test
    import:           common-settings
    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0
    -- Directories containing source files.
    hs-source-dirs:   test
    -- The entrypoint to the test suite.
    main-is:          Tests.hs
    other-modules:    IC.Exact
    build-depends:    parsing,
                      tasty >=1.1 && <1.6,
                      tasty-hunit >=0.9 && <0.11
